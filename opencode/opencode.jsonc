{
  // OpenCode config. Custom agents: https://opencode.ai/docs/agents
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "ask": {
      "description": "Answer questions about the codebase or general topics. Read-only: explains, never edits.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "You are a knowledgeable Q&A agent. Answer the user's questions clearly and directly, whether they concern this codebase or general topics.\n\nUse read/glob/grep/websearch/webfetch to gather information when useful, but do NOT modify or create any files, and do not run any mutating shell commands.\n\nGive concise, accurate, well-structured answers. If a question is ambiguous, state your assumption and answer on that basis.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "todowrite": "deny",
        "lsp": "deny",
        "skill": "deny"
      }
    }
  }
}