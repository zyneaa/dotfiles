{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "text": "#CFCFC8",
    "muted": "#8C8C87",
    "border": "#4A4A48",
    "borderActive": "#6E7E86",
    "accentPrimary": "#7FAFC4",
    "accentSecondary": "#829AA3",
    "accentAccent": "#8FB5AE",
    "err": "#C98A8F",
    "warn": "#C9A47E",
    "ok": "#94B199",
    "infoC": "#89A8C0"
  },
  "theme": {
    "primary": { "dark": "accentPrimary", "light": "#3E6E85" },
    "secondary": { "dark": "accentSecondary", "light": "#5E7781" },
    "accent": { "dark": "accentAccent", "light": "#4C7D74" },
    "error": { "dark": "err", "light": "#A8545C" },
    "warning": { "dark": "warn", "light": "#96692F" },
    "success": { "dark": "ok", "light": "#4F7A57" },
    "info": { "dark": "infoC", "light": "#3E6E8C" },

    "text": { "dark": "text", "light": "#33332F" },
    "textMuted": { "dark": "muted", "light": "#5E5E59" },

    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "none", "light": "none" },
    "backgroundElement": { "dark": "none", "light": "none" },

    "border": { "dark": "border", "light": "#C2C2BC" },
    "borderActive": { "dark": "borderActive", "light": "#6E7E86" },
    "borderSubtle": { "dark": "border", "light": "#D0D0CA" },

    "diffAdded": { "dark": "ok", "light": "ok" },
    "diffRemoved": { "dark": "err", "light": "err" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "textMuted", "light": "textMuted" },
    "diffHighlightAdded": { "dark": "ok", "light": "ok" },
    "diffHighlightRemoved": { "dark": "err", "light": "err" },
    "diffAddedBg": { "dark": "none", "light": "none" },
    "diffRemovedBg": { "dark": "none", "light": "none" },
    "diffContextBg": { "dark": "none", "light": "none" },
    "diffLineNumber": { "dark": "textMuted", "light": "textMuted" },
    "diffAddedLineNumberBg": { "dark": "none", "light": "none" },
    "diffRemovedLineNumberBg": { "dark": "none", "light": "none" },

    "markdownText": { "dark": "text", "light": "text" },
    "markdownHeading": { "dark": "accentPrimary", "light": "accentPrimary" },
    "markdownLink": { "dark": "accentPrimary", "light": "accentPrimary" },
    "markdownLinkText": { "dark": "text", "light": "text" },
    "markdownCode": { "dark": "accentAccent", "light": "accentAccent" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "text", "light": "text" },
    "markdownStrong": { "dark": "text", "light": "text" },
    "markdownHorizontalRule": { "dark": "border", "light": "border" },
    "markdownListItem": { "dark": "text", "light": "text" },
    "markdownListEnumeration": { "dark": "text", "light": "text" },
    "markdownImage": { "dark": "accentPrimary", "light": "accentPrimary" },
    "markdownImageText": { "dark": "muted", "light": "muted" },
    "markdownCodeBlock": { "dark": "text", "light": "text" },

    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "accentAccent", "light": "accentAccent" },
    "syntaxFunction": { "dark": "accentPrimary", "light": "accentPrimary" },
    "syntaxVariable": { "dark": "text", "light": "text" },
    "syntaxString": { "dark": "ok", "light": "ok" },
    "syntaxNumber": { "dark": "warn", "light": "warn" },
    "syntaxType": { "dark": "accentSecondary", "light": "accentSecondary" },
    "syntaxOperator": { "dark": "text", "light": "text" },
    "syntaxPunctuation": { "dark": "text", "light": "text" }
  }
}