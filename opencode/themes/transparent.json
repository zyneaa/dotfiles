{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "text": "#F5EFE0",
    "muted": "#A9B6BF",
    "borderC": "#C9B27A",
    "borderSubtle": "#4A5A70",
    "gold": "#E8B84B",
    "goldBright": "#F6D37A",
    "copper": "#D28A4A",
    "blue": "#8FC1E8",
    "deepblue": "#5E82A8",
    "err": "#F08A78",
    "warn": "#F0BA6A",
    "ok": "#A8D19A",
    "infoC": "#8FC1E8"
  },
  "theme": {
    "primary": { "dark": "gold", "light": "#A8760F" },
    "secondary": { "dark": "copper", "light": "#8C4E1C" },
    "accent": { "dark": "blue", "light": "#2E5E86" },
    "error": { "dark": "err", "light": "#9E3B25" },
    "warning": { "dark": "warn", "light": "#8A5B00" },
    "success": { "dark": "ok", "light": "#35603A" },
    "info": { "dark": "infoC", "light": "#2E5E86" },

    "text": { "dark": "text", "light": "#2E2A20" },
    "textMuted": { "dark": "muted", "light": "#5C5A50" },

    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "none", "light": "none" },
    "backgroundElement": { "dark": "none", "light": "none" },

    "border": { "dark": "borderC", "light": "#C9B27A" },
    "borderActive": { "dark": "goldBright", "light": "#A8760F" },
    "borderSubtle": { "dark": "borderSubtle", "light": "#C2B08A" },

    "diffAdded": { "dark": "ok", "light": "ok" },
    "diffRemoved": { "dark": "err", "light": "err" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "goldBright", "light": "goldBright" },
    "diffHighlightAdded": { "dark": "ok", "light": "ok" },
    "diffHighlightRemoved": { "dark": "err", "light": "err" },
    "diffAddedBg": { "dark": "none", "light": "none" },
    "diffRemovedBg": { "dark": "none", "light": "none" },
    "diffContextBg": { "dark": "none", "light": "none" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "none", "light": "none" },
    "diffRemovedLineNumberBg": { "dark": "none", "light": "none" },

    "markdownText": { "dark": "text", "light": "text" },
    "markdownHeading": { "dark": "gold", "light": "gold" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "text", "light": "text" },
    "markdownCode": { "dark": "goldBright", "light": "goldBright" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "text", "light": "text" },
    "markdownStrong": { "dark": "text", "light": "text" },
    "markdownHorizontalRule": { "dark": "borderSubtle", "light": "borderSubtle" },
    "markdownListItem": { "dark": "text", "light": "text" },
    "markdownListEnumeration": { "dark": "gold", "light": "gold" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "muted", "light": "muted" },
    "markdownCodeBlock": { "dark": "text", "light": "text" },

    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "goldBright", "light": "goldBright" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "text", "light": "text" },
    "syntaxString": { "dark": "ok", "light": "ok" },
    "syntaxNumber": { "dark": "warn", "light": "warn" },
    "syntaxType": { "dark": "copper", "light": "copper" },
    "syntaxOperator": { "dark": "text", "light": "text" },
    "syntaxPunctuation": { "dark": "text", "light": "text" }
  }
}